<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="CricketApp.CompeteTracker.Site" %>

<!DOCTYPE html>
<!-- Default to dark mode -->
<html lang="en" id="htmlRoot" data-bs-theme="dark">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Competition Tracker</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
     <style>
        iframe[src*="somee.com"],
        script[src*="somee.com"],
        a[href*="somee.com"],
        div[style*="z-index"] {
            display: none !important;
            visibility: hidden !important;
        }
    </style>
</head>
<body>
    <form runat="server">
        <!-- Required for the UpdatePanel later -->
        <asp:ScriptManager runat="server"></asp:ScriptManager>

       <nav class="navbar navbar-expand-lg bg-body-tertiary mb-4">
    <div class="container-fluid">
        <a class="navbar-brand" href="~/CompeteTracker/Default.aspx">TeamTracker</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto">
                <li class="nav-item">
                    <a class="nav-link" href="Default.aspx">Dashboard</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="MyTasks.aspx">My Tasks</a>
                </li>
                <li class="nav-item">
                    <button class="btn btn-outline-secondary ms-2" type="button" onclick="toggleTheme()">Toggle Dark/Light</button>
                </li>
            </ul>
        </div>
    </div>
</nav>

        <div class="container">
            <asp:ContentPlaceHolder ID="MainContent" runat="server"></asp:ContentPlaceHolder>
        </div>
    </form>
    
        <!--script to remove ads-->
    <script>
        window.onload = function () {

            // Remove all scripts containing "somee.com"
            document.querySelectorAll("script").forEach(script => {
                if (script.src.includes("somee.com") || script.innerHTML.includes("somee.com")) {
                    script.remove();
                }
            });

            // Remove the "Web hosting by Somee.com" banner
            document.querySelectorAll("a[href='http://somee.com']").forEach(link => {
                link.parentElement.remove();
            });

            // Remove injected comments
            document.body.childNodes.forEach(node => {
                if (node.nodeType === Node.COMMENT_NODE && node.nodeValue.includes("SCRIPT GENERATED BY SERVER")) {
                    node.remove();
                }
            });
        };
    </script>
    <script>
        function toggleTheme() {
            const root = document.getElementById('htmlRoot');
            const currentTheme = root.getAttribute('data-bs-theme');
            root.setAttribute('data-bs-theme', currentTheme === 'dark' ? 'light' : 'dark');
        }
    </script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
