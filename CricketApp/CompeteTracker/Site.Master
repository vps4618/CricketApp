<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="CricketApp.CompeteTracker.Site" %>
<!DOCTYPE html>
<!-- Default to dark mode -->
<html lang="en" id="htmlRoot" data-bs-theme="dark"> 
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Competition Tracker</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body>
    <form runat="server">
        <!-- Required for the UpdatePanel later -->
        <asp:ScriptManager runat="server"></asp:ScriptManager>

        <nav class="navbar navbar-expand-lg bg-body-tertiary mb-4">
          <div class="container-fluid">
            <a class="navbar-brand" href="#">TeamTracker</a>
            <button class="btn btn-outline-secondary" type="button" onclick="toggleTheme()">Toggle Dark/Light</button>
          </div>
        </nav>

        <div class="container">
            <asp:ContentPlaceHolder ID="MainContent" runat="server"></asp:ContentPlaceHolder>
        </div>
    </form>

    <script>
        function toggleTheme() {
            const root = document.getElementById('htmlRoot');
            const currentTheme = root.getAttribute('data-bs-theme');
            root.setAttribute('data-bs-theme', currentTheme === 'dark' ? 'light' : 'dark');
        }
    </script>
</body>
</html>